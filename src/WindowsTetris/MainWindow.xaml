<Window x:Class="WindowsTetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetris" Width="700" Height="780"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Grid>
        <!-- Mode Selection Screen -->
        <Grid x:Name="ModeSelectionPanel" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="T E T R I S"
                           FontSize="48" FontWeight="Bold"
                           Foreground="{StaticResource AccentPink}"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Windows Edition"
                           FontSize="16"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,48"/>

                <Button Content="STAGE MODE"
                        Style="{StaticResource ModernButton}"
                        Width="220"
                        Margin="0,0,0,16"
                        Click="StageMode_Click"/>
                <Button Content="INFINITE MODE"
                        Style="{StaticResource ModernButton}"
                        Width="220"
                        Click="InfiniteMode_Click"/>
            </StackPanel>
        </Grid>

        <!-- Game Screen -->
        <Grid x:Name="GamePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Game Board -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource GridBorder}"
                    BorderThickness="2"
                    CornerRadius="4"
                    Margin="8"
                    Padding="2">
                <Canvas x:Name="GameCanvas"
                        Width="300" Height="600"
                        ClipToBounds="True"/>
            </Border>

            <!-- Side Panel -->
            <StackPanel Grid.Column="2" Width="180" Margin="8,8,8,8" VerticalAlignment="Top">
                <!-- Mode Label -->
                <TextBlock x:Name="GameModeLabel"
                           Text="INFINITE MODE"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource AccentPink}"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,12"/>

                <!-- Next Piece -->
                <Border Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="NEXT" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center"/>
                        <Canvas x:Name="NextPieceCanvas" Width="120" Height="80" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Score -->
                <Border Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="SCORE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ScoreText" Text="0" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Border>

                <!-- Level -->
                <Border Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="LEVEL" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="LevelText" Text="1" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Border>

                <!-- Lines -->
                <Border Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="LINES" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="LinesText" Text="0" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Border>

                <!-- Stage (shown only in stage mode) -->
                <Border x:Name="StagePanel"
                        Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="STAGE" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="StageText" Text="1" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Border>

                <!-- Time -->
                <Border Background="{StaticResource PanelDark}"
                        BorderBrush="{StaticResource GridBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TIME" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="TimeText" Text="00:00:00" Style="{StaticResource InfoValue}" FontSize="18"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <Button x:Name="PauseButton" Content="PAUSE"
                        Style="{StaticResource ModernButton}"
                        FontSize="13" Padding="16,8"
                        Margin="0,0,0,6"
                        Click="Pause_Click"/>
                <Button x:Name="BackButton" Content="BACK TO MENU"
                        Style="{StaticResource ModernButton}"
                        FontSize="13" Padding="16,8"
                        Click="Back_Click"/>
            </StackPanel>
        </Grid>

        <!-- Overlay for Game Over / Pause / Clear -->
        <Grid x:Name="OverlayPanel" Visibility="Collapsed"
              Background="#AA000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="OverlayText"
                           Text="GAME OVER"
                           FontSize="42" FontWeight="Bold"
                           Foreground="{StaticResource AccentPink}"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button x:Name="OverlayButton"
                        Content="RESTART"
                        Style="{StaticResource ModernButton}"
                        Width="200"
                        Click="Restart_Click"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
